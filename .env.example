# Opções do docker-compose.yml da raiz. Copie para ".env" só se precisar
# mudar algo; sem este arquivo, os valores abaixo já são os padrões.

# Porta do site no navegador (http://localhost:8080)
WEB_PORTA=8080

# Porta da API. Troque se a 3333 já estiver em uso (por exemplo, pela API
# rodando com npm run dev). O site é remontado com o endereço novo.
API_PORTA=3333

# "false" desliga a consulta às ruas e usa só a estimativa em linha reta.
ROTAS_PELAS_RUAS=true

# Servidores de rotas. Para os próprios (perfil osrm), use:
#   OSRM_URL_CARRO=http://osrm-carro:5000
#   OSRM_URL_A_PE=http://osrm-a-pe:5000
OSRM_URL_CARRO=https://router.project-osrm.org
OSRM_URL_A_PE=https://routing.openstreetmap.de/routed-foot
