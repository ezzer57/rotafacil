# Endereco da API do RotaFacil.
#
# Deixe VAZIO ou remova a linha para o aplicativo rodar com dados simulados,
# sem precisar de servidor.
#
# Navegador, no mesmo computador da API:
#   EXPO_PUBLIC_API_URL=http://localhost:3333
#
# Celular pelo Expo Go: localhost aponta para o proprio aparelho, entao use o
# IP do computador na rede local (veja com `ipconfig`):
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
#
# Testes em campo, com a API publicada:
#   EXPO_PUBLIC_API_URL=https://rotafacil-api.onrender.com

EXPO_PUBLIC_API_URL=
