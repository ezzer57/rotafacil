# Porta do servidor
PORT=3333

# Ambiente: development | test | production
NODE_ENV=development

# Conexao com o PostgreSQL (o docker-compose cria este banco)
DATABASE_URL="postgresql://rotafacil:rotafacil@localhost:5432/rotafacil?schema=public"

# Porta do banco no computador. Se a 5432 ja estiver ocupada por outro
# PostgreSQL, use outra (ex.: 5433) e ajuste a porta da DATABASE_URL junto.
DB_PORTA=5432

# Segredo de assinatura do JWT - MINIMO 32 CARACTERES
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRA_EM="7d"

# Origens autorizadas a chamar a API, separadas por virgula
CORS_ORIGENS="http://localhost:8081,http://localhost:19006"

# Limite de requisicoes por janela de 15 minutos, por IP
RATE_LIMIT_MAX=300

# Nivel de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
