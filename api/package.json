{
  "name": "rotafacil-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do RotaFácil: roteirização turística com estimativa de custo e controle de micro-orçamento",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.{js,ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "contrato": "postman collection run postman/rotafacil.postman_collection.json -e postman/local.postman_environment.json"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.10.1",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  }
}
